# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- Paths ----
TXTAV_DB_PATH=data/txtav.db
TXTAV_PROFILE_DIR=.pw-profile
TXTAV_PARTS_XLSX=data/PN_List_full.xlsx
TXTAV_FIXTURES_DIR=fixtures
TXTAV_LOG_DIR=logs
TXTAV_SCREENSHOT_DIR=screenshots

# ---- Pacing ----
# 109,589 TXT parts over 14 days of continuous running is 11.0 s per part.
# Raise this number to go slower. Never lower it without agreeing a new cycle length.
TXTAV_REQUEST_INTERVAL_SECONDS=11.0
TXTAV_JITTER_SECONDS=2.0
TXTAV_CYCLE_DAYS=14

# Optional daily operating window in 24h local time. Leave blank for 24/7.
# A window shortens the available hours, so the pacer raises the rate to compensate.
TXTAV_WINDOW_START=
TXTAV_WINDOW_END=

# ---- Reliability ----
TXTAV_MAX_NETWORK_RETRIES=3
TXTAV_BACKOFF_BASE_SECONDS=5.0
TXTAV_CONSECUTIVE_FAILURE_HALT=3
TXTAV_PAGE_TIMEOUT_SECONDS=45

# ---- Portal ----
TXTAV_BASE_URL=https://ww2.txtav.com
# Credentials are NEVER stored here. First login is performed by hand in the
# browser window opened by `txtav login`, and the session lives in the profile dir.

# ---- Alerting ----
# Webhook URL for halt and daily summary notifications. Leave blank to log only.
TXTAV_ALERT_WEBHOOK=
TXTAV_ALERT_MIN_LEVEL=warning
