# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- Paths ----
TXTAV_DB_PATH=data/txtav.db
TXTAV_PROFILE_DIR=.pw-profile
TXTAV_PARTS_XLSX=data/PN_List_full.xlsx
TXTAV_FIXTURES_DIR=fixtures
TXTAV_LOG_DIR=logs
TXTAV_SCREENSHOT_DIR=screenshots

# ---- Pacing ----
# 109,589 TXT parts over 14 days of continuous running is 11.0 s per part.
# Raise this number to go slower. Never lower it without agreeing a new cycle length.
TXTAV_REQUEST_INTERVAL_SECONDS=11.0
TXTAV_JITTER_SECONDS=2.0
TXTAV_CYCLE_DAYS=14

# Optional daily operating window in 24h local time. Leave blank for 24/7.
# A window shortens the available hours, so the pacer raises the rate to compensate.
TXTAV_WINDOW_START=
TXTAV_WINDOW_END=

# ---- Reliability ----
TXTAV_MAX_NETWORK_RETRIES=3
TXTAV_BACKOFF_BASE_SECONDS=5.0
TXTAV_CONSECUTIVE_FAILURE_HALT=3
TXTAV_PAGE_TIMEOUT_SECONDS=45

# ---- Portal ----
TXTAV_BASE_URL=https://ww2.txtav.com
# Credentials are NEVER stored here. First login is performed by hand in the
# browser window opened by `txtav login`, and the session lives in the profile dir.

# ---- Output spreadsheet ----
# A native Google Sheet. An uploaded .xlsx will not work: the Sheets API
# cannot write into one. A native sheet's id is 44 characters and its URL
# carries no rtpof=true.
TXTAV_SHEET_ID=
TXTAV_SHEET_TAB=Output
# OAuth client JSON from the Google Cloud project, and the token this app
# writes after the one time consent. Never committed; secrets/ is gitignored.
#
# OAuth rather than a service account because the client's Google organization
# enforces iam.managed.disableServiceAccountKeyCreation, so no service account
# key can be issued. The OAuth app is Internal, which keeps it inside their
# organization and does not expire the refresh token after seven days.
TXTAV_GOOGLE_CLIENT_SECRETS=secrets/google-oauth-client.json
TXTAV_GOOGLE_TOKEN=secrets/google-token.json

# ---- Alerting ----
# Webhook URL for halt and daily summary notifications. Leave blank to log only.
TXTAV_ALERT_WEBHOOK=
TXTAV_ALERT_MIN_LEVEL=warning
